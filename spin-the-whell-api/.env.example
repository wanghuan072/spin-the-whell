# Runtime database connection. Use the pooled Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require

# Secret used to create non-reversible request-IP hashes. Use at least 32 random characters.
IP_HASH_SECRET=replace-with-a-random-ip-hash-secret

# Web application client ID from Google Cloud. Use the same ID in the frontend.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Browser origin allowed to call the API directly during local development.
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# Used only by `npm run admin:seed`. Remove the password after seeding.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
